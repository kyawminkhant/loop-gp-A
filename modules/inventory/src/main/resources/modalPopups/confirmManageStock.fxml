<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>


<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="LoopsFirstYearProject.LoopsFirstYearProject.controllers.ManageStockPopup"
      spacing="20"
      styleClass="root-pane"
      stylesheets="@../styles/manageStock.css">


    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>



    <Label text="📋 Transfer Summary"
           styleClass="title"/>



    <ScrollPane fitToWidth="true"
                prefHeight="500">


        <VBox fx:id="summaryContainer"
              spacing="15"
              fillWidth="true"/>


    </ScrollPane>



    <HBox alignment="CENTER"
          spacing="20">


        <Button text="Cancel"
                onAction="#cancel"
                styleClass="trash-btn"/>



        <Button text="Confirm Transfer"
                onAction="#confirmTransfer"
                styleClass="transfer-btn"/>


    </HBox>


</VBox>