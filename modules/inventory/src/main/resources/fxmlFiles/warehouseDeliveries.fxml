<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1200.0"
            stylesheets="@../styles/warehouseDeliveries.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="LoopsFirstYearProject.LoopsFirstYearProject.controllers.WarehouseDeliveryController"
            styleClass="delivery-page">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18">
            <padding><Insets top="18" right="28" bottom="14" left="28"/></padding>
            <ImageView fx:id="logo" fitWidth="104" fitHeight="72" preserveRatio="true"/>
            <VBox spacing="3">
                <Label text="Warehouse Deliveries" styleClass="page-title"/>
                <Label text="Inbound ingredients automatically update the destination warehouse stock."
                       styleClass="page-subtitle"/>
            </VBox>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Back to Inventory" onAction="#back" styleClass="secondary-button"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16">
            <padding><Insets top="8" right="28" bottom="28" left="28"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="toolbar">
                <Label text="Warehouse" styleClass="toolbar-label"/>
                <ComboBox fx:id="warehouseFilter" prefWidth="180"/>
                <Label fx:id="queueLabel" text="0 active inbound deliveries" styleClass="queue-label"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="Generate Delivery" onAction="#createDelivery" styleClass="secondary-button"/>
                <Button text="Run Update Now" onAction="#advanceDelivery" styleClass="primary-button"/>
            </HBox>
            <Label fx:id="updateLabel" text="" styleClass="update-label"/>
            <TableView fx:id="deliveryTable" VBox.vgrow="ALWAYS" styleClass="delivery-table">
                <columns>
                    <TableColumn fx:id="deliveryIdColumn" text="Delivery" prefWidth="75"/>
                    <TableColumn fx:id="warehouseColumn" text="Warehouse" prefWidth="90"/>
                    <TableColumn fx:id="areaColumn" text="Service Area" prefWidth="125"/>
                    <TableColumn fx:id="ingredientColumn" text="Ingredient" prefWidth="200"/>
                    <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="85"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="105"/>
                    <TableColumn fx:id="expectedColumn" text="Expected" prefWidth="150"/>
                    <TableColumn fx:id="updatedColumn" text="Last Update" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
