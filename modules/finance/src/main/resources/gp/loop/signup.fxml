<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="signup-root"
           xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gp.loop.SignupController">

   <VBox alignment="CENTER" spacing="6" maxWidth="440">
      <padding>
         <Insets top="30" bottom="30" left="40" right="40" />
      </padding>

      <!-- Loop logo -->
      <ImageView fitHeight="150" preserveRatio="true">
         <image><Image url="@/gp/loop/loop-logo.png" /></image>
      </ImageView>

      <Region prefHeight="6" />

      <!-- Title pill (same style as dashboard header) -->
      <Label text="Finance &amp; reporting"
             style="-fx-font-size:20px;-fx-font-weight:800;-fx-padding:14 44;-fx-background-radius:999;-fx-border-radius:999;-fx-background-color:linear-gradient(to bottom right, rgba(255,136,0,0.40), rgba(255,136,0,0.20));-fx-border-color:rgba(255,255,255,0.80);-fx-border-width:1.6;-fx-text-fill:#1a3a1a;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.12),16,0.3,0,5);" />

      <Label text="Sign in to view the financial dashboard"
             style="-fx-text-fill:rgba(26,58,26,0.65);-fx-font-size:14px;" />

      <Region prefHeight="14" />

      <!-- Liquid glass card -->
      <VBox spacing="7" styleClass="signup-card">
         <padding>
            <Insets top="28" bottom="28" left="26" right="26" />
         </padding>

         <Label text="Email" styleClass="signup-field-label" />
         <TextField fx:id="emailField" promptText="admin@loop.co.uk" styleClass="signup-field" />

         <Region prefHeight="5" />

         <Label text="Password" styleClass="signup-field-label" />
         <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="signup-field" />

         <Region prefHeight="5" />

         <Label text="Confirm Password" styleClass="signup-field-label" />
         <PasswordField fx:id="confirmPasswordField" promptText="••••••••" styleClass="signup-field" />

         <Region prefHeight="6" />

         <!-- Error label -->
         <Label fx:id="errorLabel" text="" visible="false" managed="false"
                style="-fx-text-fill:#C62828;-fx-font-size:13px;-fx-font-weight:600;" wrapText="true" />

         <Region prefHeight="2" />

         <!-- Sign up (orange glass pill, like Export CSV) -->
         <Button text="Sign up" onAction="#handleSignup" styleClass="signup-btn-primary"
                 maxWidth="Infinity" />

         <!-- Log in (green glass pill, like Back buttons) -->
         <Button text="Already have an account?  Log in" onAction="#handleLogin"
                 styleClass="signup-btn-secondary" maxWidth="Infinity" />
      </VBox>

      <Region prefHeight="12" />

      <!-- Footer -->
      <Label text="Fresh meals delivered weekly to your door."
             style="-fx-text-fill:rgba(26,58,26,0.55);-fx-font-size:12px;"
             wrapText="true" textAlignment="CENTER" />

      <Label text="Demo admin: admin@loop.co.uk / admin123"
             style="-fx-text-fill:rgba(26,58,26,0.40);-fx-font-size:11px;"
             wrapText="true" textAlignment="CENTER" />
   </VBox>
</StackPane>
