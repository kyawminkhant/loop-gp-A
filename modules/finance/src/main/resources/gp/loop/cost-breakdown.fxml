<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="22.0" styleClass="root" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gp.loop.finance.CostBreakdownController">
   <padding>
      <Insets top="18.0" bottom="24.0" left="24.0" right="24.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Button mnemonicParsing="false" onAction="#backToHome" text="← Back" style="-fx-font-size:16px;-fx-font-weight:700;-fx-padding:14 32;-fx-background-radius:999;-fx-border-radius:999;-fx-background-color:rgba(27,94,32,0.35);-fx-border-color:rgba(255,255,255,0.75);-fx-border-width:1.6;-fx-text-fill:#1a3a1a;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.12),16,0.3,0,5);" />
         </children>
      </HBox>
      <ImageView fitHeight="250.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@/gp/loop/loop-logo.png" />
         </image>
      </ImageView>
      <Button mnemonicParsing="false" onAction="#refresh" styleClass="button-orange" text="Cost Breakdown" />
      <StackPane maxWidth="720.0" prefHeight="350.0" styleClass="chart-card pie-card">
         <children>
            <PieChart fx:id="pieCostBreakdown" clockwise="true" labelsVisible="true" legendVisible="true" startAngle="90.0" styleClass="cost-breakdown-chart" />
         </children>
      </StackPane>
   </children>
</VBox>
