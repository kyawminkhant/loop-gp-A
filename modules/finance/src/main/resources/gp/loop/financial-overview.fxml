<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="30.0" styleClass="root" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gp.loop.finance.FinancialOverviewController">
   <padding>
      <Insets top="18.0" bottom="24.0" left="20.0" right="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Button mnemonicParsing="false" onAction="#backToHome" text="← Back" style="-fx-font-size:16px;-fx-font-weight:700;-fx-padding:14 32;-fx-background-radius:999;-fx-border-radius:999;-fx-background-color:rgba(27,94,32,0.35);-fx-border-color:rgba(255,255,255,0.75);-fx-border-width:1.6;-fx-text-fill:#1a3a1a;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.12),16,0.3,0,5);" />
         </children>
      </HBox>
      <ImageView fitHeight="130.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@/gp/loop/loop-logo.png" />
         </image>
      </ImageView>
      <Button mnemonicParsing="false" onAction="#refresh" styleClass="button-orange" text="Financial Overview" />
      <FlowPane alignment="CENTER" columnHalignment="CENTER" hgap="16.0" prefWrapLength="760.0" vgap="16.0">
         <children>
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label styleClass="overview-chip" text="Startup Costs" />
                  <Label fx:id="labelStartupCosts" styleClass="overview-value-chip" text="£0.00" />
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label styleClass="overview-chip" text="Monthly Revenue" />
                  <Label fx:id="labelMonthlyRevenue" styleClass="overview-value-chip" text="£0.00" />
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label styleClass="overview-chip" text="Monthly Costs" />
                  <Label fx:id="labelMonthlyCosts" styleClass="overview-value-chip" text="£0.00" />
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label styleClass="overview-chip" text="Monthly Profit" />
                  <Label fx:id="labelMonthlyProfit" styleClass="overview-value-chip" text="£0.00" />
               </children>
            </VBox>
         </children>
      </FlowPane>
   </children>
</VBox>
