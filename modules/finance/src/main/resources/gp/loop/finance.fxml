<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane root dashboard-scroll dashboard-app-root" style="-fx-background-color:#FFF8E1;-fx-background:#FFF8E1;-fx-control-inner-background:#FFF8E1;" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gp.loop.finance.FinanceController">
   <content>
      <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="finance-page finance-dashboard-root" style="-fx-background-color:#FFF8E1;">
         <padding>
            <Insets bottom="36.0" left="20.0" right="20.0" top="12.0" />
         </padding>
         <children>
            <!-- Top row: Back button -->
            <HBox alignment="CENTER_LEFT" spacing="14.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#backToHome" text="← Back" style="-fx-font-size:16px;-fx-font-weight:700;-fx-padding:14 32;-fx-background-radius:999;-fx-border-radius:999;-fx-background-color:rgba(27,94,32,0.35);-fx-border-color:rgba(255,255,255,0.75);-fx-border-width:1.6;-fx-text-fill:#1a3a1a;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.12),16,0.3,0,5);" />
                  <Region HBox.hgrow="ALWAYS" />
                  <MenuButton mnemonicParsing="false" text="More" style="-fx-font-size:16px;-fx-font-weight:700;-fx-padding:14 32;-fx-background-radius:999;-fx-border-radius:999;-fx-background-color:rgba(27,94,32,0.35);-fx-border-color:rgba(255,255,255,0.75);-fx-border-width:1.6;-fx-text-fill:#1a3a1a;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.12),16,0.3,0,5);">
                     <items>
                        <MenuItem onAction="#refresh" text="Refresh" />
                        <MenuItem onAction="#addDemoOrder" text="Add demo order" />
                        <SeparatorMenuItem />
                        <MenuItem onAction="#exportCsvReport" text="Export CSV (30 days)" />
                        <MenuItem onAction="#showExecutiveSummary" text="Executive summary" />
                     </items>
                  </MenuButton>
               </children>
            </HBox>
            <!-- Logo -->
            <ImageView fitHeight="250.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@/gp/loop/loop-logo.png" />
               </image>
            </ImageView>
            <!-- Title pill -->
            <Label text="Revenue by week" style="-fx-font-size:18px;-fx-font-weight:700;-fx-padding:14 40;-fx-background-radius:999;-fx-border-radius:999;-fx-background-color:rgba(255,136,0,0.35);-fx-border-color:rgba(255,255,255,0.75);-fx-border-width:1.6;-fx-text-fill:#1a3a1a;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.12),16,0.3,0,5);" />
            <!-- Table -->
            <TableView fx:id="tableOrders" maxWidth="920.0" minHeight="280.0" prefHeight="420.0" styleClass="finance-table dashboard-table" style="-fx-background-color:transparent;-fx-border-color:transparent;-fx-border-width:0;-fx-background-insets:0;-fx-table-cell-border-color:transparent;" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colDate" minWidth="100.0" prefWidth="260.0" text="Order Date" />
                  <TableColumn fx:id="colTotal" minWidth="80.0" prefWidth="160.0" text="Total Price" />
                  <TableColumn fx:id="colCost" minWidth="80.0" prefWidth="140.0" text="Cost" />
                  <TableColumn fx:id="colProfit" minWidth="80.0" prefWidth="140.0" text="Profit" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </content>
</ScrollPane>
