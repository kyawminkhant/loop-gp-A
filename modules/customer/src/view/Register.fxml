<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.RegisterController"
            styleClass="page-root">

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="glass-scroll">
            <content>
                <StackPane>
                    <padding>
                        <Insets top="28" right="28" bottom="28" left="28"/>
                    </padding>

                    <Button text="← Back to Login" onAction="#handleBackToLogin"
                            styleClass="back-button"
                            StackPane.alignment="TOP_LEFT"/>

                    <VBox alignment="CENTER" spacing="14" styleClass="glass-card"
                          prefWidth="700" maxWidth="700">
                        <padding>
                            <Insets top="36" right="50" bottom="36" left="50"/>
                        </padding>

                        <ImageView fx:id="logoImage" fitWidth="150" preserveRatio="true">
                            <image>
                                <Image url="@/images/nobglooplogo.png"/>
                            </image>
                        </ImageView>

                        <Label text="Create Customer Account" styleClass="brand-title-small"/>
                        <Label text="Fill in your details below. Upload your ID card picture. Email and ID number cannot be changed later."
                               styleClass="helper-text"/>

                        <GridPane hgap="16" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                            </columnConstraints>

                            <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                <Label text="Full Name" styleClass="field-label"/>
                                <TextField fx:id="nameField" promptText="e.g. Jane Smith"
                                           styleClass="glass-input" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="5" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <Label text="Email Address" styleClass="field-label"/>
                                <TextField fx:id="emailField" promptText="you@example.com"
                                           styleClass="glass-input" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                <Label text="Mobile Number" styleClass="field-label"/>
                                <TextField fx:id="mobileField" promptText="10–15 digits"
                                           styleClass="glass-input" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <Label text="ID Card Number" styleClass="field-label"/>
                                <TextField fx:id="idCardField" promptText="Unique ID document number"
                                           styleClass="glass-input" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="5" GridPane.rowIndex="2" GridPane.columnIndex="0">
                                <Label text="Password" styleClass="field-label"/>
                                <PasswordField fx:id="passwordField" promptText="At least 6 characters"
                                               styleClass="glass-input" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="5" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <Label text="Confirm Password" styleClass="field-label"/>
                                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password"
                                               styleClass="glass-input" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="5" GridPane.rowIndex="3" GridPane.columnIndex="0"
                                  GridPane.columnSpan="2">
                                <Label text="Delivery Address" styleClass="field-label"/>
                                <TextField fx:id="addressField" promptText="Street, city, postcode"
                                           styleClass="glass-input" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="8" GridPane.rowIndex="4" GridPane.columnIndex="0"
                                  GridPane.columnSpan="2">
                                <Label text="ID Card Picture" styleClass="field-label"/>
                                <HBox spacing="14" alignment="CENTER_LEFT">
                                    <ImageView fx:id="idCardPreview" fitWidth="120" fitHeight="80" preserveRatio="true"
                                               styleClass="id-preview"/>
                                    <VBox spacing="6">
                                        <Button text="Upload ID Photo" onAction="#handleChooseIdCardImage"
                                                styleClass="secondary-button"/>
                                        <Label fx:id="idCardFileLabel" text="No file selected" styleClass="helper-text"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </GridPane>

                        <Label fx:id="messageLabel" styleClass="message-label" wrapText="true"/>

                        <Button text="Register Account" onAction="#handleRegister"
                                styleClass="primary-button" maxWidth="Infinity"/>
                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
