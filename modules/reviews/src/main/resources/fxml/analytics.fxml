<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.geometry.Insets?>

<StackPane styleClass="app-bg" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="loop.reviews.controller.AnalyticsController">
    <BorderPane>
        <top>
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="14">
                <padding><Insets top="14" right="22" bottom="14" left="22"/></padding>
                <Button text="&lt; Back" styleClass="btn-ghost" onAction="#goBack"/>
                <Label text="Review Analytics" styleClass="topbar-brand"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </top>
        <center>
            <VBox spacing="16" styleClass="content">
                <padding><Insets top="22" right="26" bottom="22" left="26"/></padding>
                <Label fx:id="productNameLabel" styleClass="page-title"/>

                <HBox spacing="16">
                    <VBox spacing="8" styleClass="card">
                        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                        <Label text="Rating distribution" styleClass="section-title"/>
                        <PieChart fx:id="distributionChart" legendVisible="true" prefWidth="380" prefHeight="300"/>
                    </VBox>

                    <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
                        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                        <Label text="Summary" styleClass="section-title"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label fx:id="avgStarsLabel" styleClass="stars-big"/>
                            <Label fx:id="avgValueLabel" styleClass="avg-value"/>
                        </HBox>
                        <Label fx:id="totalLabel" styleClass="product-meta"/>

                        <Label text="Sentiment analysis" styleClass="section-title"/>
                        <VBox fx:id="sentimentBox" spacing="8"/>
                    </VBox>
                </HBox>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
