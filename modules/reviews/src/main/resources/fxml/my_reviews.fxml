<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="root" styleClass="app-bg" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="loop.reviews.controller.MyReviewsController">
    <BorderPane>
        <top>
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="14">
                <padding><Insets top="14" right="22" bottom="14" left="22"/></padding>
                <Button text="&lt; Home" styleClass="btn-ghost" onAction="#goHome"/>
                <Label text="My Reviews" styleClass="topbar-brand"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </top>
        <center>
            <VBox spacing="12" styleClass="content">
                <padding><Insets top="20" right="26" bottom="20" left="26"/></padding>
                <Label text="Edit or delete your reviews within the time window" styleClass="page-title"/>
                <Label text="Reviews can be changed for 24 hours after posting. After that they lock permanently."
                       styleClass="page-subtitle"/>
                <ScrollPane fitToWidth="true" styleClass="scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="reviewList" spacing="12"/>
                </ScrollPane>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
