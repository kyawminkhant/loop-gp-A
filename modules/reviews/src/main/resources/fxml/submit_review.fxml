<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="root" styleClass="app-bg" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="loop.reviews.controller.SubmitReviewController">
    <BorderPane>
        <top>
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="14">
                <padding><Insets top="14" right="22" bottom="14" left="22"/></padding>
                <Button text="&lt; Back" styleClass="btn-ghost" onAction="#goBack"/>
                <Label text="Write a Review" styleClass="topbar-brand"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </top>
        <center>
            <VBox alignment="TOP_CENTER" styleClass="content">
                <padding><Insets top="24" right="26" bottom="24" left="26"/></padding>
                <VBox spacing="16" maxWidth="620" styleClass="card">
                    <padding><Insets top="24" right="30" bottom="24" left="30"/></padding>
                    <Label fx:id="productNameLabel" styleClass="page-title"/>
                    <Label fx:id="eligibilityLabel" styleClass="hint" wrapText="true"/>

                    <VBox spacing="6">
                        <Label text="Your rating" styleClass="field-label"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ComboBox fx:id="ratingCombo"/>
                            <Label fx:id="ratingPreview" styleClass="stars-big"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Your review" styleClass="field-label"/>
                        <TextArea fx:id="commentArea" promptText="Tell others what you thought..."
                                  wrapText="true" prefRowCount="5"/>
                        <Label text="Maximum 500 characters." styleClass="hint"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Photo (optional)" styleClass="field-label"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="imageField" promptText="No file selected" editable="false" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="browseImageButton" text="Browse..." styleClass="btn-ghost" onAction="#browseImage"/>
                            <Button fx:id="removeImageButton" text="Remove" styleClass="btn-ghost"
                                    onAction="#clearSelectedImage" visible="false" managed="false"/>
                        </HBox>
                        <StackPane fx:id="imagePreviewBox" styleClass="review-photo-preview"
                                   visible="false" managed="false" alignment="CENTER_LEFT">
                            <ImageView fx:id="imagePreview" fitWidth="520" fitHeight="230"
                                       preserveRatio="true" smooth="true"/>
                        </StackPane>
                        <Label text="PNG, JPG, JPEG or GIF. Maximum 12 MB; saved as an optimized PNG."
                               styleClass="hint" wrapText="true"/>
                    </VBox>

                    <Label fx:id="errorLabel" styleClass="error-text" wrapText="true"/>

                    <HBox spacing="12">
                        <Button fx:id="submitButton" text="Submit Review" styleClass="btn-primary" onAction="#handleSubmit"/>
                        <Button text="Cancel" styleClass="btn-ghost" onAction="#goBack"/>
                    </HBox>
                </VBox>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
