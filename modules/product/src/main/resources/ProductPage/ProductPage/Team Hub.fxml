<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ProductPage.ProductPage.TeamHubController"
           maxWidth="Infinity"
           maxHeight="Infinity"
           styleClass="team-hub-page">

    <Pane mouseTransparent="true"
          maxWidth="Infinity"
          maxHeight="Infinity"
          styleClass="background-overlay" />

    <VBox maxWidth="Infinity"
          maxHeight="Infinity"
          spacing="24"
          styleClass="team-hub-frame">

        <HBox alignment="CENTER_LEFT"
              spacing="28"
              styleClass="team-hub-header">
            <ImageView fitWidth="118"
                       fitHeight="118"
                       preserveRatio="true"
                       pickOnBounds="true">
                <image>
                    <Image url="@images/nobglooplogo.png" />
                </image>
            </ImageView>

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Loop Team Hub"
                       styleClass="team-hub-title" />
                <Label text="Choose a component to open"
                       styleClass="team-hub-subtitle" />
            </VBox>

            <Label text="7 Components"
                   styleClass="team-hub-count" />
        </HBox>

        <VBox alignment="TOP_CENTER"
              spacing="18"
              styleClass="team-hub-content">
            <Label text="Assessment B Implementation"
                   styleClass="team-hub-section-title" />

            <GridPane hgap="22"
                      vgap="22"
                      alignment="CENTER"
                      styleClass="team-hub-grid">
                <padding>
                    <Insets top="8" right="16" bottom="18" left="16" />
                </padding>

                <Button mnemonicParsing="false"
                        onAction="#openProducts"
                        styleClass="component-card, component-card-live"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0">
                    <graphic>
                        <VBox alignment="CENTER" spacing="12">
                            <ImageView fitWidth="72" fitHeight="72" preserveRatio="true">
                                <image>
                                    <Image url="@hubs-icon/products.png" />
                                </image>
                            </ImageView>
                            <Label text="Products" styleClass="component-title" />
                            <Label text="Food catalogue and product details"
                                   wrapText="true"
                                   styleClass="component-caption" />
                        </VBox>
                    </graphic>
                </Button>

                <Button mnemonicParsing="false"
                        onAction="#openCustomers"
                        styleClass="component-card"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0">
                    <graphic>
                        <VBox alignment="CENTER" spacing="12">
                            <ImageView fitWidth="72" fitHeight="72" preserveRatio="true">
                                <image>
                                    <Image url="@hubs-icon/customers.png" />
                                </image>
                            </ImageView>
                            <Label text="Customers" styleClass="component-title" />
                            <Label text="Customer profiles and accounts"
                                   wrapText="true"
                                   styleClass="component-caption" />
                        </VBox>
                    </graphic>
                </Button>

                <Button mnemonicParsing="false"
                        onAction="#openOrders"
                        styleClass="component-card"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="0">
                    <graphic>
                        <VBox alignment="CENTER" spacing="12">
                            <ImageView fitWidth="72" fitHeight="72" preserveRatio="true">
                                <image>
                                    <Image url="@hubs-icon/orders.png" />
                                </image>
                            </ImageView>
                            <Label text="Orders" styleClass="component-title" />
                            <Label text="Order basket and order history"
                                   wrapText="true"
                                   styleClass="component-caption" />
                        </VBox>
                    </graphic>
                </Button>

                <Button mnemonicParsing="false"
                        onAction="#openDelivery"
                        styleClass="component-card"
                        GridPane.columnIndex="3"
                        GridPane.rowIndex="0">
                    <graphic>
                        <VBox alignment="CENTER" spacing="12">
                            <ImageView fitWidth="72" fitHeight="72" preserveRatio="true">
                                <image>
                                    <Image url="@hubs-icon/delivery&amp;logistics.png" />
                                </image>
                            </ImageView>
                            <Label text="Delivery &amp; Logistics" styleClass="component-title" />
                            <Label text="Delivery routes and dispatch"
                                   wrapText="true"
                                   styleClass="component-caption" />
                        </VBox>
                    </graphic>
                </Button>

                <Button mnemonicParsing="false"
                        onAction="#openInventory"
                        styleClass="component-card"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="1">
                    <graphic>
                        <VBox alignment="CENTER" spacing="12">
                            <ImageView fitWidth="72" fitHeight="72" preserveRatio="true">
                                <image>
                                    <Image url="@hubs-icon/inventory-warehousing.png" />
                                </image>
                            </ImageView>
                            <Label text="Inventory / Warehousing" styleClass="component-title" />
                            <Label text="Stock, ingredients, and storage"
                                   wrapText="true"
                                   styleClass="component-caption" />
                        </VBox>
                    </graphic>
                </Button>

                <Button mnemonicParsing="false"
                        onAction="#openReviews"
                        styleClass="component-card"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="1">
                    <graphic>
                        <VBox alignment="CENTER" spacing="12">
                            <ImageView fitWidth="72" fitHeight="72" preserveRatio="true">
                                <image>
                                    <Image url="@hubs-icon/reviews&amp;ratings.png" />
                                </image>
                            </ImageView>
                            <Label text="Reviews &amp; Ratings" styleClass="component-title" />
                            <Label text="Product feedback and scores"
                                   wrapText="true"
                                   styleClass="component-caption" />
                        </VBox>
                    </graphic>
                </Button>

                <Button mnemonicParsing="false"
                        onAction="#openFinance"
                        styleClass="component-card"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="1">
                    <graphic>
                        <VBox alignment="CENTER" spacing="12">
                            <ImageView fitWidth="72" fitHeight="72" preserveRatio="true">
                                <image>
                                    <Image url="@hubs-icon/finance&amp;reporting.png" />
                                </image>
                            </ImageView>
                            <Label text="Finance &amp; Reporting" styleClass="component-title" />
                            <Label text="Sales totals and reports"
                                   wrapText="true"
                                   styleClass="component-caption" />
                        </VBox>
                    </graphic>
                </Button>

                <Region GridPane.columnIndex="3"
                        GridPane.rowIndex="1" />
            </GridPane>

            <Label fx:id="statusLabel"
                   text="All seven components are connected to the shared database."
                   styleClass="team-hub-status" />
        </VBox>
    </VBox>
</StackPane>
