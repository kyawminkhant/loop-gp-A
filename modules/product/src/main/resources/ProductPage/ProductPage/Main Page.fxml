<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.Pane?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ProductPage.ProductPage.PrimaryController"
           maxWidth="Infinity"
           maxHeight="Infinity">
           
    <fx:define>
	    <ToggleGroup fx:id="dietaryGroup" />
	    <ToggleGroup fx:id="sortGroup" />
	    <ToggleGroup fx:id="cuisineGroup" />
	    <ToggleGroup fx:id="healthyGroup" />
	</fx:define>
	
	<Pane mouseTransparent="true"
      maxWidth="Infinity"
      maxHeight="Infinity"
      styleClass="background-overlay" />
      
    <VBox maxWidth="Infinity"
          maxHeight="Infinity"
          spacing="10"
          styleClass="app-frame">

        <HBox alignment="CENTER_LEFT"
              prefHeight="128"
              maxWidth="Infinity"
              spacing="30"
              styleClass="header-bar">
            <VBox.margin>
                <Insets left="-8" right="-8" />
            </VBox.margin>

            <ImageView fitWidth="120"
                       fitHeight="120"
                       pickOnBounds="true"
                       preserveRatio="true">
                <image>
                    <Image url="@images/nobglooplogo.png" />
                </image>
            </ImageView>

            <HBox alignment="CENTER_LEFT"
                  prefHeight="180"
                  minWidth="280"
                  prefWidth="760"
                  maxWidth="Infinity"
                  spacing="10"
                  HBox.hgrow="ALWAYS"
                  styleClass="search-box">
                <TextField fx:id="searchField"
                           HBox.hgrow="ALWAYS"
                           promptText="Search Loop"
                           styleClass="search-input" />

                <Button fx:id="searchButton"
                        mnemonicParsing="false"
                        onAction="#applySearch"
                        styleClass="search-icon-button">
                    <graphic>
                        <ImageView fitWidth="24"
                                   fitHeight="24"
                                   pickOnBounds="true"
                                   preserveRatio="true">
                            <image>
                                <Image url="@images/search.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <Button fx:id="accountButton"
			        mnemonicParsing="false"
			        onAction="#openCustomerAccount"
			        styleClass="header-action-button, account-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="18">
                        <ImageView fitWidth="48"
                                   fitHeight="32"
                                   pickOnBounds="true"
                                   preserveRatio="true"
                                   styleClass="account-image">
                            <image>
                                <Image url="@images/user.png" />
                            </image>
                        </ImageView>

                        <Label fx:id="accountNameLabel"
                               text="Hungry, Guest?"
                               styleClass="header-action-text" />
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="ordersButton"
			        mnemonicParsing="false"
			        styleClass="header-action-button, orders-button">
                <graphic>
                    <HBox alignment="CENTER" spacing="10">
                        <Label fx:id="orderCountLabel"
                               text="0"
                               styleClass="simple-order-count" />
                        <Label text="Orders"
                               styleClass="header-action-text" />
                    </HBox>
                </graphic>
            </Button>
        </HBox>

            <HBox alignment="CENTER"
                  maxWidth="Infinity"
                  styleClass="filter-wrap">
            <HBox alignment="CENTER"
                  maxWidth="Infinity"
                  prefWidth="920"
                  spacing="60"
                  styleClass="filter-row">

                <Button fx:id="sortButton"
                        onAction="#toggleSortPopup"
                        mnemonicParsing="false"
                        styleClass="filter-button">
                    <graphic>
                        <HBox alignment="CENTER" spacing="8">
                            <ImageView fitWidth="24"
                                       fitHeight="24"
                                       preserveRatio="true"
                                       styleClass="filter-icon-image">
                                <image>
                                    <Image url="@images/sort.png" />
                                </image>
                            </ImageView>
                            <Label text="Sort &amp; Filter" styleClass="filter-text" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="highlyRatedButton"
                        mnemonicParsing="false"
                        onAction="#toggleHighlyRated"
                        styleClass="filter-button">
                    <graphic>
                        <HBox alignment="CENTER" spacing="8">
                            <ImageView fitWidth="24"
                                       fitHeight="24"
                                       preserveRatio="true"
                                       styleClass="filter-icon-image">
                                <image>
                                    <Image url="@images/rated.png" />
                                </image>
                            </ImageView>
                            <Label text="Highly Rated" styleClass="filter-text" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="healthGoalButton"
                        mnemonicParsing="false"
                        onAction="#toggleHealthPlanner"
                        styleClass="filter-button">
                    <graphic>
                        <HBox alignment="CENTER" spacing="8">
                            <ImageView fitWidth="24"
                                       fitHeight="24"
                                       preserveRatio="true"
                                       styleClass="filter-icon-image">
                                <image>
                                    <Image url="@images/health.png" />
                                </image>
                            </ImageView>
                            <Label text="Healthy Goals" styleClass="filter-text" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="lowCalorieButton"
                        mnemonicParsing="false"
                        onAction="#toggleLowCalorie"
                        styleClass="filter-button">
                    <graphic>
                        <HBox alignment="CENTER" spacing="8">
                            <ImageView fitWidth="24"
                                       fitHeight="24"
                                       preserveRatio="true"
                                       styleClass="filter-icon-image">
                                <image>
                                    <Image url="@images/low-calories.png" />
                                </image>
                            </ImageView>
                            <Label text="Low Calorie" styleClass="filter-text" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="budgetPicksButton"
                        mnemonicParsing="false"
                        onAction="#toggleBudgetPicks"
                        styleClass="filter-button">
                    <graphic>
                        <HBox alignment="CENTER" spacing="8">
                            <ImageView fitWidth="24"
                                       fitHeight="24"
                                       preserveRatio="true"
                                       styleClass="filter-icon-image">
                                <image>
                                    <Image url="@images/budget.png" />
                                </image>
                            </ImageView>
                            <Label text="Budget Picks" styleClass="filter-text" />
                        </HBox>
                    </graphic>
                </Button>
            </HBox>
        </HBox>

        <HBox alignment="CENTER" maxWidth="Infinity">
            <Label fx:id="preferenceSummaryLabel"
                   text="Sign in through Customers to personalise your recommendations."
                   wrapText="true"
                   styleClass="preference-summary" />
        </HBox>
    
    <ScrollPane fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="NEVER"
            VBox.vgrow="ALWAYS"
            styleClass="food-scroll">
	    <VBox fx:id="foodList"
	          alignment="TOP_CENTER"
	          maxWidth="Infinity"
	          spacing="28"
	          styleClass="food-list" />
	</ScrollPane>
	
    </VBox>
    
	<Pane fx:id="japaneseDecorLayer"
	      mouseTransparent="true"
	      pickOnBounds="false"
	      maxWidth="Infinity"
	      maxHeight="Infinity"
	      StackPane.alignment="CENTER" />

    <VBox fx:id="foodDetailView"
          visible="false"
          managed="false"
          prefWidth="900"
          maxWidth="Infinity"
          spacing="10"
          styleClass="food-detail-view"
          StackPane.alignment="TOP_CENTER">
        <StackPane.margin>
            <Insets top="54" />
        </StackPane.margin>

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="food-detail-header">
            <Button text="Back To Menu"
                    mnemonicParsing="false"
                    onAction="#closeFoodDetails"
                    styleClass="detail-back-button" />
        </HBox>

        <HBox alignment="TOP_LEFT" spacing="18" styleClass="food-detail-main">
            <VBox alignment="CENTER" spacing="7" styleClass="detail-gallery">
                <ImageView fx:id="detailFoodImage"
                           fitWidth="236"
                           fitHeight="236"
                           preserveRatio="false"
                           smooth="true"
                           styleClass="detail-food-image" />
                <HBox alignment="CENTER" spacing="10">
                    <Button fx:id="previousDetailImageButton"
                            text="Prev"
                            mnemonicParsing="false"
                            onAction="#showPreviousDetailImage"
                            styleClass="detail-image-button" />
                    <Label fx:id="detailImageCounterLabel"
                           text="1 / 1"
                           styleClass="detail-image-counter" />
                    <Button fx:id="nextDetailImageButton"
                            text="Next"
                            mnemonicParsing="false"
                            onAction="#showNextDetailImage"
                            styleClass="detail-image-button" />
                </HBox>
            </VBox>

            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label fx:id="detailFoodNameLabel"
                               text="Food Name"
                               styleClass="detail-food-name" />
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <HBox fx:id="detailStarsBox"
                                  alignment="CENTER_LEFT"
                                  spacing="1" />
                            <Label fx:id="detailReviewLabel"
                                   text="0.0 (0)"
                                   styleClass="detail-review" />
                        </HBox>
                    </VBox>
                    <Label fx:id="detailPriceLabel"
                           text="&#163;0.00"
                           styleClass="food-price" />
                </HBox>

                <Region minHeight="1"
                        prefHeight="1"
                        maxHeight="1"
                        styleClass="food-divider" />

                <HBox alignment="TOP_LEFT" spacing="14">
                    <VBox spacing="7" minWidth="150">
                        <Label text="Tags" styleClass="detail-section-title" />
                        <Label fx:id="detailDietaryLabel"
                               text="Dietary"
                               styleClass="detail-tag" />
                        <Label fx:id="detailGoalLabel"
                               text="Goal"
                               styleClass="detail-tag" />
                        <Label fx:id="detailCuisineLabel"
                               text="Cuisine"
                               styleClass="detail-tag" />
                    </VBox>

                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Overview" styleClass="detail-section-title" />
                        <Label fx:id="detailDescriptionLabel"
                               text="Food description"
                               wrapText="true"
                               styleClass="detail-description" />
                        <Label text="Nutrition Facts" styleClass="detail-section-title" />
                        <Label fx:id="detailNutritionLabel"
                               text="Calories: 0 kcal"
                               wrapText="true"
                               styleClass="detail-nutrition" />
                    </VBox>
                </HBox>
            </VBox>

            <VBox spacing="8" minWidth="150" prefWidth="150" styleClass="detail-side-panel">
                <Label text="You Might Also Like" styleClass="detail-section-title" />
                <Label text="Similar meals will appear here." wrapText="true" styleClass="detail-description" />
            </VBox>
        </HBox>
    </VBox>

    <VBox fx:id="healthPlanner"
          visible="false"
          managed="false"
          prefWidth="610"
          maxWidth="610"
          spacing="10"
          styleClass="health-planner"
          StackPane.alignment="TOP_CENTER">
        <StackPane.margin>
            <Insets top="218" />
        </StackPane.margin>

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="health-planner-header">
            <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                <image>
                    <Image url="@images/health.png" />
                </image>
            </ImageView>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Build Your Meal Plan" styleClass="health-planner-title" />
                <Label text="Choose a training goal and build your daily meal split."
                       styleClass="health-planner-subtitle" />
            </VBox>
            <Button text="Close"
                    mnemonicParsing="false"
                    onAction="#closeHealthPlanner"
                    styleClass="health-planner-close" />
        </HBox>

        <HBox alignment="CENTER" spacing="12" styleClass="health-goal-row">
            <Button fx:id="weightLossPlanButton"
                    text="Weight Loss"
                    mnemonicParsing="false"
                    onAction="#selectWeightLossPlan"
                    styleClass="health-goal-choice" />
            <Button fx:id="highProteinPlanButton"
                    text="High Protein"
                    mnemonicParsing="false"
                    onAction="#selectHighProteinPlan"
                    styleClass="health-goal-choice" />
            <Button fx:id="balancedPlanButton"
                    text="Balanced Meals"
                    mnemonicParsing="false"
                    onAction="#selectBalancedPlan"
                    styleClass="health-goal-choice" />
        </HBox>

        <HBox alignment="CENTER" spacing="12" styleClass="health-plan-config">
            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="health-config-card">
                <Label text="Daily calorie target" styleClass="health-config-title" />
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <TextField fx:id="healthCalorieField"
                               text="2000"
                               promptText="Daily kcal"
                               onAction="#refreshHealthPlanCalories"
                               HBox.hgrow="ALWAYS"
                               styleClass="health-calorie-field" />
                    <Label text="kcal/day" styleClass="health-calorie-unit" />
                </HBox>
                <HBox spacing="7">
                    <Button fx:id="lightCalorieButton"
                            text="1500"
                            mnemonicParsing="false"
                            onAction="#selectLightCalories"
                            styleClass="health-calorie-preset" />
                    <Button fx:id="standardCalorieButton"
                            text="2000"
                            mnemonicParsing="false"
                            onAction="#selectStandardCalories"
                            styleClass="health-calorie-preset" />
                    <Button fx:id="fuelCalorieButton"
                            text="2500"
                            mnemonicParsing="false"
                            onAction="#selectFuelCalories"
                            styleClass="health-calorie-preset" />
                </HBox>
            </VBox>

            <VBox spacing="8" styleClass="health-config-card health-split-card">
                <Label text="Meals per day" styleClass="health-config-title" />
                <Spinner fx:id="healthMealSplitSpinner"
                         editable="false"
                         prefWidth="128"
                         styleClass="health-meal-spinner" />
                <Label fx:id="healthPerMealLabel"
                       text="About 667 kcal per meal"
                       styleClass="health-per-meal" />
            </VBox>
        </HBox>
        <Label fx:id="healthCalorieErrorLabel"
               text=""
               wrapText="true"
               visible="false"
               managed="false"
               styleClass="health-calorie-error" />

        <Label fx:id="healthPlanFocusLabel"
               text="Select a goal to create your plan."
               wrapText="true"
               styleClass="health-plan-focus" />

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    prefViewportHeight="205"
                    maxHeight="205"
                    styleClass="health-plan-scroll">
            <content>
                <VBox fx:id="healthPlanMealList"
                      spacing="6"
                      fillWidth="true"
                      styleClass="health-plan-meals" />
            </content>
        </ScrollPane>

        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="health-plan-actions">
            <Label fx:id="healthPlanTotalLabel"
                   text="Plan total: &#163;0.00"
                   HBox.hgrow="ALWAYS"
                   styleClass="health-plan-total" />
            <Button text="Show All"
                    mnemonicParsing="false"
                    onAction="#resetHealthPlan"
                    styleClass="health-plan-secondary" />
            <Button fx:id="showHealthPlanButton"
                    text="Show These Meals"
                    mnemonicParsing="false"
                    onAction="#showSuggestedHealthPlan"
                    disable="true"
                    styleClass="health-plan-primary" />
        </HBox>
    </VBox>
	      
   <VBox fx:id="sortPopup"
      visible="false"
      managed="false"
      minHeight="-Infinity"
      prefHeight="-1"
      maxHeight="-Infinity"
      spacing="4"
      styleClass="sort-popup"
      StackPane.alignment="TOP_LEFT">
	
	    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="sort-popup-header">
	        <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
	            <image>
	                <Image url="@images/sort.png" />
	            </image>
	        </ImageView>
	        <Label text="Sort &amp; Filter" styleClass="popup-title" />
	    </HBox>
	
	    <VBox spacing="9" styleClass="popup-section">
	        <Label text="SORT BY" styleClass="popup-section-title, popup-button-row" />
	        <HBox spacing="18" styleClass="popup-button-row">
	            <ToggleButton fx:id="popupHighlyRatedToggle" text="Highly Rated" toggleGroup="$sortGroup" mnemonicParsing="false" styleClass="popup-select-button" />
	            <ToggleButton fx:id="popupNewestToggle" text="Newest" toggleGroup="$sortGroup" mnemonicParsing="false" styleClass="popup-select-button" />
	            <ToggleButton fx:id="popupLowCalorieToggle" text="Low-Calorie" toggleGroup="$sortGroup" mnemonicParsing="false" styleClass="popup-select-button" />
	        </HBox>
	        
	        <HBox spacing="18" styleClass="popup-button-row">
	            <ToggleButton fx:id="popupCheapestToggle" text="Cheapest" toggleGroup="$sortGroup" mnemonicParsing="false" styleClass="popup-select-button" />
	        </HBox>
	    </VBox>
	
	    <VBox spacing="9" styleClass="popup-section">
	        <Label text="DIETARY" styleClass="popup-section-title, popup-button-row" />
	        <HBox spacing="10" styleClass="popup-button-row">
	        	<ToggleButton fx:id="vegetarianToggle"
	        				  toggleGroup="$dietaryGroup"
				              mnemonicParsing="false"
				              styleClass="popup-chip">
				    <graphic>
				        <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/vegetarian.png" />
				                </image>
				            </ImageView>
				            <Label text="Vegetarian" />
				        </HBox>
				    </graphic>
				</ToggleButton>
				
				<ToggleButton fx:id="veganToggle"
							  toggleGroup="$dietaryGroup"
				              mnemonicParsing="false"
				              styleClass="popup-chip">
				    <graphic>
				        <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/vegan.png" />
				                </image>
				            </ImageView>
				            <Label text="Vegan" />
				        </HBox>
				    </graphic>
				</ToggleButton>
			
				<ToggleButton fx:id="halalToggle"
							  toggleGroup="$dietaryGroup"
				              mnemonicParsing="false"
				              styleClass="popup-chip">
				    <graphic>
				         <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/halal.png" />
				                </image>
				            </ImageView>
				            <Label text="Halal" />
				        </HBox>
				    </graphic>
				</ToggleButton>
				
				<ToggleButton fx:id="glutenFreeToggle"
							  toggleGroup="$dietaryGroup"
				              mnemonicParsing="false"
				              styleClass="popup-chip">
				    <graphic>
				        <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/gluten-free.png" />
				                </image>
				            </ImageView>
				            <Label text="Gluten-Free" />
				        </HBox>
				    </graphic>
				</ToggleButton>
	        </HBox>
	        
	        <HBox spacing="10" styleClass="popup-button-row">
	            <ToggleButton fx:id="pescatarianToggle"
	            			  toggleGroup="$dietaryGroup"
				              mnemonicParsing="false"
				              styleClass="popup-chip">
				    <graphic>
				        <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/pescatarian.png" />
				                </image>
				            </ImageView>
				            <Label text="Pescatarian" />
				        </HBox>
				    </graphic>
				</ToggleButton>
	        </HBox>
	    </VBox>
	
	    <VBox spacing="9" styleClass="popup-section">
	        <Label text="HEALTHY GOALS" styleClass="popup-section-title, popup-button-row" />
	        <HBox spacing="10" styleClass="popup-button-row">
	        <ToggleButton fx:id="weightLossFilterToggle"
	        			  toggleGroup="$healthyGroup"
				              mnemonicParsing="false"
				              styleClass="popup-chip">
				    <graphic>
				        <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/weight-loss.png" />
				                </image>
				            </ImageView>
				            <Label text="Weight Loss" />
				        </HBox>
				    </graphic>
				</ToggleButton>
			
				<ToggleButton fx:id="highProteinFilterToggle"
							  toggleGroup="$healthyGroup"
				              mnemonicParsing="false"
				              styleClass="popup-chip">
				    <graphic>
				         <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/high-protein.png" />
				                </image>
				            </ImageView>
				            <Label text="High Protein" />
				        </HBox>
				    </graphic>
				</ToggleButton>
				
				<ToggleButton fx:id="balancedMealsFilterToggle"
							  toggleGroup="$healthyGroup"
				              mnemonicParsing="false"
				              styleClass="popup-chip">
				    <graphic>
				         <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/balanced-meals.png" />
				                </image>
				            </ImageView>
				            <Label text="Balanced Meals" />
				        </HBox>
				    </graphic>
				</ToggleButton>
	        </HBox>
	    </VBox>
	
	    <VBox spacing="9" styleClass="popup-section">
	        <Label text="CUISINE" styleClass="popup-section-title, popup-button-row" />
	        <HBox spacing="10" styleClass="popup-button-row">
	            <ToggleButton fx:id="asianToggle" toggleGroup="$cuisineGroup" mnemonicParsing="false" styleClass="popup-chip">
				    <graphic>
				        <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/asian.png" />
				                </image>
				            </ImageView>
				            <Label text="Asian" />
				        </HBox>
				    </graphic>
				</ToggleButton>
	            <ToggleButton fx:id="southeastAsianToggle" toggleGroup="$cuisineGroup" mnemonicParsing="false" styleClass="popup-chip">
				    <graphic>
				        <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/southeast-asian.png" />
				                </image>
				            </ImageView>
				            <Label text="Southeast Asian" />
				        </HBox>
				    </graphic>
				</ToggleButton>
	            <ToggleButton fx:id="southAsianToggle" toggleGroup="$cuisineGroup" mnemonicParsing="false" styleClass="popup-chip">
				    <graphic>
				        <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/south-asian.png" />
				                </image>
				            </ImageView>
				            <Label text="South Asian" />
				        </HBox>
				    </graphic>
				</ToggleButton>
	        </HBox>
	        <HBox spacing="10" styleClass="popup-button-row">
	            <ToggleButton fx:id="middleEasternToggle" toggleGroup="$cuisineGroup" mnemonicParsing="false" styleClass="popup-chip">
				    <graphic>
				        <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/middle-eastern.png" />
				                </image>
				            </ImageView>
				            <Label text="Middle Eastern" />
				        </HBox>
				    </graphic>
				</ToggleButton>
	            <ToggleButton fx:id="westernToggle" toggleGroup="$cuisineGroup" mnemonicParsing="false" styleClass="popup-chip">
				    <graphic>
				        <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/middle-eastern.png" />
				                </image>
				            </ImageView>
				            <Label text="Western" />
				        </HBox>
				    </graphic>
				</ToggleButton>
	            <ToggleButton fx:id="mediterraneanToggle" toggleGroup="$cuisineGroup" mnemonicParsing="false" styleClass="popup-chip">
				    <graphic>
				        <HBox alignment="CENTER" spacing="6">
				            <ImageView fitHeight="18"
				                       fitWidth="18"
				                       preserveRatio="true"
				                       styleClass="popup-icon-image">
				                <image>
				                    <Image url="@FilterBox/mediterranean.png" />
				                </image>
				            </ImageView>
				            <Label text="Mediterranean" />
				        </HBox>
				    </graphic>
				</ToggleButton>
	        </HBox>
	    </VBox>
	
	    <VBox spacing="9" styleClass="popup-section">
	        <Label text="PRICE RANGE" styleClass="popup-section-title, popup-button-row" />
	        <HBox alignment="CENTER_LEFT"
			      spacing="0"
			      styleClass="price-row, popup-button-row">
			
			    <TextField fx:id="minPriceField"
				           promptText="Min Price"
				           styleClass="price-field" />
				
				<Region styleClass="price-connector" />
				
				<TextField fx:id="maxPriceField"
				           promptText="Max Price"
				           styleClass="price-field" />
			</HBox>
			<Label fx:id="priceErrorLabel"
			       text=""
			       visible="false"
			       managed="false"
			       styleClass="price-error" />
	    </VBox>
	    
	    <HBox alignment="CENTER_RIGHT" styleClass="popup-apply-row">
		    <Button fx:id="applyFiltersButton"
		            text="Apply"
		            mnemonicParsing="false"
		            onAction="#applyFilters"
		            styleClass="popup-apply-button" />
		</HBox>
	</VBox>

</StackPane>
