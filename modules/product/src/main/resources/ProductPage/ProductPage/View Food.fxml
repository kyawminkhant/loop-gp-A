<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ProductPage.ProductPage.ViewFoodController"
           maxWidth="Infinity"
           maxHeight="Infinity"
           styleClass="view-food-page">

    <Region mouseTransparent="true"
            maxWidth="Infinity"
            maxHeight="Infinity"
            styleClass="background-overlay" />

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="NEVER"
                maxWidth="Infinity"
                maxHeight="Infinity"
                styleClass="view-food-scroll">
        <content>
    <VBox minWidth="760"
          prefWidth="1180"
          maxWidth="Infinity"
          spacing="0"
          styleClass="view-food-panel">
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              styleClass="view-food-header">
            <Button text="&lt;  Back To Menu"
                    mnemonicParsing="false"
                    onAction="#goBackToMenu"
                    styleClass="detail-back-button" />
        </HBox>

        <VBox spacing="14" styleClass="view-food-body">
            <HBox alignment="TOP_LEFT" spacing="22">
                <VBox alignment="CENTER" spacing="8" styleClass="view-food-gallery">
                    <ImageView fx:id="foodImageView"
                               fitWidth="320"
                               fitHeight="320"
                               preserveRatio="false"
                               smooth="true"
                               styleClass="view-food-image" />
                    <HBox alignment="CENTER" spacing="10">
                        <Button text="Prev"
                                mnemonicParsing="false"
                                onAction="#showPreviousImage"
                                styleClass="detail-image-button" />
                        <Label fx:id="imageCounterLabel"
                               text="1 / 1"
                               styleClass="detail-image-counter" />
                        <Button text="Next"
                                mnemonicParsing="false"
                                onAction="#showNextImage"
                                styleClass="detail-image-button" />
                    </HBox>
                </VBox>

                <VBox spacing="9" prefWidth="1000" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label fx:id="foodNameLabel"
                                   text="Food Name"
                                   styleClass="detail-food-name" />
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <HBox fx:id="ratingStarsBox"
                                      alignment="CENTER_LEFT"
                                      spacing="1" />
                                <Label fx:id="ratingCountLabel"
                                       text="0.0 (0)"
                                       styleClass="detail-review" />
                            </HBox>
                        </VBox>
                        <Label fx:id="priceLabel"
                               text="&#163;0.00"
                               styleClass="food-price" />
                    </HBox>

                    <Region minHeight="1"
                            prefHeight="1"
                            maxHeight="1"
                            styleClass="food-divider" />

                    <HBox alignment="CENTER_LEFT" spacing="18">
                        <VBox spacing="8" minWidth="210" prefWidth="210">
                            <Label text="Tags" styleClass="detail-section-title" />
                            <Label fx:id="dietaryLabel"
                                   text="Dietary"
                                   styleClass="detail-tag" />
                            <Label fx:id="goalLabel"
                                   text="Goal"
                                   styleClass="detail-tag" />
                            <Label fx:id="cuisineLabel"
                                   text="Cuisine"
                                   styleClass="detail-tag" />
                        </VBox>

                        <Region minWidth="1"
                                prefWidth="1"
                                maxWidth="1"
                                minHeight="126"
                                styleClass="facts-divider" />

                        <VBox alignment="CENTER" spacing="5" minWidth="180" prefWidth="180">
                            <Label text="Cuisine" styleClass="detail-section-title" />
                            <StackPane fx:id="countryFlagFrame"
                                       minWidth="86"
                                       prefWidth="86"
                                       maxWidth="86"
                                       minHeight="86"
                                       prefHeight="86"
                                       maxHeight="86"
                                       styleClass="country-flag-frame">
                                <ImageView fx:id="countryFlagImage"
                                           fitWidth="86"
                                           fitHeight="86"
                                           preserveRatio="false"
                                           smooth="true"
                                           StackPane.alignment="CENTER"
                                           styleClass="country-flag-image" />
                            </StackPane>
                            <Label fx:id="countryLabel"
                                   text="Country"
                                   styleClass="detail-review" />
                        </VBox>

                        <Region minWidth="1"
                                prefWidth="1"
                                maxWidth="1"
                                minHeight="126"
                                styleClass="facts-divider" />

                        <VBox alignment="CENTER" spacing="10" minWidth="300" prefWidth="300">
                            <HBox alignment="CENTER" spacing="0" minWidth="132" prefWidth="132" maxWidth="132" styleClass="quantity-stepper">
                                <Button fx:id="decreaseQuantityButton"
                                        text="-"
                                        mnemonicParsing="false"
                                        onAction="#decreaseQuantity"
                                        styleClass="cart-step-button, cart-step-left" />
                                <Label fx:id="quantityLabel"
                                       text="1"
                                       styleClass="cart-quantity-label" />
                                <Button fx:id="increaseQuantityButton"
                                        text="+"
                                        mnemonicParsing="false"
                                        onAction="#increaseQuantity"
                                        styleClass="cart-step-button, cart-step-right" />
                            </HBox>
                            <Button fx:id="subscriptionButton"
                                    text="Weekly"
                                    mnemonicParsing="false"
                                    onAction="#toggleSubscription"
                                    styleClass="subscription-toggle" />
                            <Button fx:id="addToCartButton"
                                    text="Add to Cart"
                                    mnemonicParsing="false"
                                    onAction="#addToCart"
                                    styleClass="add-cart-button" />
                            <Label fx:id="inventoryAvailabilityLabel"
                                   visible="false"
                                   managed="false"
                                   wrapText="true"
                                   textAlignment="CENTER"
                                   styleClass="inventory-unavailable-label" />
                            <HBox alignment="CENTER" spacing="8" styleClass="top-summary-row">
                                <Label fx:id="topCaloriesLabel"
                                       text="0 kcal"
                                       styleClass="top-summary-pill" />
                                <HBox fx:id="topSpiceBox"
                                      alignment="CENTER"
                                      spacing="2"
                                      styleClass="top-summary-pill" />
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

            </HBox>

            <Region minHeight="1"
                    prefHeight="1"
                    maxHeight="1"
                    styleClass="food-divider" />

            <HBox alignment="CENTER_LEFT" spacing="28" styleClass="detail-breadcrumb-row">
                <Button fx:id="overviewTabButton"
                        text="Overview"
                        mnemonicParsing="false"
                        onAction="#showOverviewTab"
                        styleClass="detail-breadcrumb, detail-breadcrumb-active" />
                <Button fx:id="ingredientsTabButton"
                        text="Ingredients"
                        mnemonicParsing="false"
                        onAction="#showIngredientsTab"
                        styleClass="detail-breadcrumb" />
                <Button fx:id="chefTabButton"
                        text="About the Chef"
                        mnemonicParsing="false"
                        onAction="#showChefTab"
                        styleClass="detail-breadcrumb" />
                <Button fx:id="reviewsTabButton"
                        text="Reviews"
                        mnemonicParsing="false"
                        onAction="#showReviewsTab"
                        styleClass="detail-breadcrumb" />
            </HBox>

            <HBox alignment="TOP_LEFT" spacing="22" styleClass="detail-lower-section">
                <VBox spacing="12"
                      minWidth="1010"
                      prefWidth="1010"
                      maxWidth="1010"
                      styleClass="detail-info-area">
                    <VBox fx:id="overviewContent" spacing="12">
                        <Label text="Overview" styleClass="detail-section-title" />
                        <Label fx:id="tabInfoLabel"
                               text="More food details can be added here."
                               wrapText="true"
                               maxWidth="1010"
                               styleClass="detail-description" />
                        <VBox spacing="2" styleClass="detail-allergen-box">
                            <Label text="Allergens:" styleClass="detail-section-title" />
                            <Label fx:id="allergenAlertLabel"
                                   text="No major allergens detected."
                                   wrapText="true"
                                   maxWidth="1010"
                                   styleClass="allergen-alert" />
                        </VBox>
                        <Region minHeight="1"
                                prefHeight="1"
                                maxHeight="1"
                                styleClass="food-divider" />
                        <Label text="Nutrition Facts" styleClass="detail-section-title" />
                        <Label text="Serving size: ~400-450g"
                               styleClass="detail-review" />
                        <GridPane fx:id="nutritionTable"
                                  minWidth="310"
                                  prefWidth="310"
                                  maxWidth="310"
                                  hgap="0"
                                  vgap="0"
                                  styleClass="nutrition-table" />
                    </VBox>

                    <VBox fx:id="ingredientsContent"
                          visible="false"
                          managed="false"
                          spacing="18"
                          styleClass="ingredient-customizer">
                        <Label text="Customize Your Meal"
                               styleClass="ingredient-customizer-title" />
                        <HBox spacing="36" alignment="TOP_LEFT">
                            <VBox spacing="10" minWidth="300" prefWidth="300">
                                <Label text="Base" styleClass="ingredient-section-title" />
                                <VBox fx:id="baseChoiceBox" spacing="10" />
                            </VBox>
                            <Region minWidth="1"
                                    prefWidth="1"
                                    maxWidth="1"
                                    minHeight="150"
                                    styleClass="facts-divider" />
                            <VBox spacing="10" minWidth="300" prefWidth="300">
                                <Label text="Protein" styleClass="ingredient-section-title" />
                                <VBox fx:id="proteinChoiceBox" spacing="10" />
                            </VBox>
                        </HBox>

                        <Region minHeight="1"
                                prefHeight="1"
                                maxHeight="1"
                                styleClass="food-divider" />

                        <VBox spacing="12">
                            <Label text="Add-ons" styleClass="ingredient-section-title" />
                            <HBox spacing="80">
                                <VBox fx:id="addOnColumnLeft" spacing="10" />
                                <VBox fx:id="addOnColumnRight" spacing="10" />
                            </HBox>
                        </VBox>

                        <Region minHeight="1"
                                prefHeight="1"
                                maxHeight="1"
                                styleClass="food-divider" />

                        <HBox spacing="36" alignment="TOP_LEFT">
                            <VBox spacing="12" minWidth="300" prefWidth="300">
                                <Label text="Spice Level" styleClass="ingredient-section-title" />
                                <HBox fx:id="spiceChoiceBox" spacing="8">
                                    <ToggleButton text="0" styleClass="spice-choice" />
                                    <ToggleButton text="1" styleClass="spice-choice" />
                                    <ToggleButton text="2" styleClass="spice-choice" />
                                    <ToggleButton text="3" styleClass="spice-choice" />
                                    <ToggleButton text="4" styleClass="spice-choice" />
                                    <ToggleButton text="5" styleClass="spice-choice" />
                                </HBox>
                            </VBox>
                            <Region minWidth="1"
                                    prefWidth="1"
                                    maxWidth="1"
                                    minHeight="130"
                                    styleClass="facts-divider" />
                            <VBox spacing="10" minWidth="300" prefWidth="300">
                                <Label text="Portion Size" styleClass="ingredient-section-title" />
                                <VBox fx:id="portionChoiceBox" spacing="10">
                                    <ToggleButton text="Regular"
                                                  selected="true"
                                                  styleClass="ingredient-choice" />
                                    <ToggleButton text="Large (+&#163;2)"
                                                  styleClass="ingredient-choice" />
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox fx:id="chefContent"
                          visible="false"
                          managed="false"
                          spacing="18"
                          styleClass="chef-profile">
                        <HBox spacing="42" alignment="TOP_LEFT">
                            <VBox spacing="14" minWidth="330" prefWidth="330" maxWidth="330">
                                <StackPane minWidth="300"
                                           prefWidth="300"
                                           maxWidth="300"
                                           minHeight="430"
                                           prefHeight="430"
                                           maxHeight="430"
                                           styleClass="chef-photo-frame">
                                    <ImageView fx:id="chefImageView"
                                               fitWidth="300"
                                               fitHeight="430"
                                               preserveRatio="false"
                                               smooth="true"
                                               styleClass="chef-photo" />
                                    <Label text="Chef Image"
                                           visible="false"
                                           managed="false"
                                           styleClass="chef-photo-placeholder" />
                                </StackPane>

                                <VBox spacing="18" styleClass="chef-contact-card">
                                    <Label text="Contact"
                                           styleClass="chef-contact-title" />
                                    <Label fx:id="chefEmailLabel"
                                           text="Email: chef@example.com"
                                           styleClass="chef-contact-text" />
                                    <Label fx:id="chefTelLabel"
                                           text="Tel: +44 (0)1234 567890"
                                           styleClass="chef-contact-text" />
                                </VBox>
                            </VBox>

                            <VBox spacing="22" minWidth="540" prefWidth="540" maxWidth="540">
                                <VBox spacing="14">
                                    <Label text="Meet the Chef"
                                           styleClass="chef-kicker" />
                                    <Label fx:id="chefNameLabel"
                                           text="Chef Placeholder Name"
                                           wrapText="true"
                                           styleClass="chef-name" />
                                    <Label fx:id="chefDescriptionLabel"
                                           text="A creative culinary expert blending traditional recipes with modern health-focused meals. This dummy section can later load chef image, name, biography, contact details, rating, and review data from your database."
                                           wrapText="true"
                                           maxWidth="520"
                                           styleClass="chef-bio" />
                                </VBox>

                                <VBox spacing="18" styleClass="chef-feature-list">
                                    <HBox alignment="CENTER_LEFT" spacing="18">
                                        <ImageView fx:id="chefInspiredIcon"
                                                   fitWidth="38"
                                                   fitHeight="38"
                                                   preserveRatio="true"
                                                   smooth="true"
                                                   styleClass="chef-feature-image" />
                                        <Label fx:id="chefTag1Label"
                                               text="Inspired by Asian Street Food"
                                               styleClass="chef-feature-text" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="18">
                                        <ImageView fx:id="chefHealthIcon"
                                                   fitWidth="38"
                                                   fitHeight="38"
                                                   preserveRatio="true"
                                                   smooth="true"
                                                   styleClass="chef-feature-image" />
                                        <Label fx:id="chefTag2Label"
                                               text="Health-Driven Cooking"
                                               styleClass="chef-feature-text" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="18">
                                        <ImageView fx:id="chefExperienceIcon"
                                                   fitWidth="38"
                                                   fitHeight="38"
                                                   preserveRatio="true"
                                                   smooth="true"
                                                   styleClass="chef-feature-image" />
                                        <Label fx:id="chefTag3Label"
                                               text="18+ Years of Culinary Experience"
                                               styleClass="chef-feature-text" />
                                    </HBox>
                                </VBox>

                                <VBox alignment="CENTER_LEFT" spacing="12" styleClass="chef-rating-box">
                                    <HBox fx:id="chefRatingStarsBox"
                                          alignment="CENTER"
                                          spacing="1"
                                          styleClass="chef-stars" />
                                    <Button fx:id="chefRatingReviewButton"
                                            text="0"
                                            mnemonicParsing="false"
                                            onAction="#showChefReviewsPlaceholder"
                                            styleClass="chef-rating-text" />
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox fx:id="suggestionPanel"
                      spacing="10"
                      minWidth="272"
                      prefWidth="272"
                      maxWidth="272"
                      styleClass="detail-side-panel">
                    <Label text="You Might Also Like"
                           styleClass="detail-section-title" />
                    <StackPane minHeight="410"
                               prefHeight="410"
                               maxHeight="410"
                               styleClass="suggestion-viewport">
                        <ScrollPane fitToWidth="true"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED"
                                    styleClass="suggestion-scroll">
                            <content>
                                <VBox fx:id="suggestionList"
                                      spacing="12"
                                      styleClass="suggestion-list" />
                            </content>
                        </ScrollPane>
                    </StackPane>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
        </content>
    </ScrollPane>
</StackPane>
