<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="LoopProject.loopproject.controllers.AssigningDrivers"
            stylesheets="@../styles/assigningDrivers.css"
            styleClass="assigningdrivers">
    <center>
        <HBox>
            <ImageView fx:id="logo" fitWidth="150" preserveRatio="true">
                <image><Image url="@../images/logo.png"/></image>
            </ImageView>

            <VBox styleClass="main-container" alignment="TOP_CENTER" maxHeight="650" spacing="12">
                <Label text="Assign Drivers" styleClass="section-title"/>
                <Label text="Orders and statuses are shared with the Orders component."
                       styleClass="customername" wrapText="true"/>

                <ScrollPane fitToWidth="true" prefHeight="500"
                            styleClass="driver-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="assignmentList" spacing="16" styleClass="driver-list"/>
                </ScrollPane>

                <Label fx:id="statusLabel" text="Select a driver for an order."
                       styleClass="customername" wrapText="true"/>
                <HBox spacing="12">
                    <Button text="← Back" onAction="#goBack" styleClass="back-button"/>
                    <Button text="Active Deliveries" onAction="#showActiveDeliveries"
                            styleClass="action-button"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
