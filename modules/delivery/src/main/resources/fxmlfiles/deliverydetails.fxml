<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
fx:controller="LoopProject.loopproject.controllers.DeliveryDetailsController"   
         stylesheets="@../styles/deliverydetail.css"
            prefWidth="1000"
            prefHeight="720"
            styleClass="deliverydetails">
<center>
    <VBox spacing="45">
     <BorderPane.margin>
                <Insets top="45" left="70" right="70" bottom="45"/>
     </BorderPane.margin>
          

        <Label text="Loop" styleClass="logo-text"/>

        <VBox spacing="0" styleClass="table-area">
            <Label text="Delivery Details" styleClass="section-title"/>

            <TableView fx:id="deliverydetailsTable" prefHeight="430" styleClass="deliverydetails-table">
                <columns>
                    <TableColumn fx:id="deliveryIdColumn" text="Delivery ID" prefWidth="110"/>
                    <TableColumn fx:id="orderIdColumn" text="Order ID" prefWidth="90"/>
                    <TableColumn fx:id="customerNameColumn" text="Customer" prefWidth="160"/>
                    <TableColumn fx:id="customerAddressColumn" text="Address" prefWidth="280"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="130"/>
                    <TableColumn fx:id="driverColumn" text="Driver" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
        
       <Button text="← Back"
                onAction="#goBack"
                styleClass="back-button"/>
    </VBox>
</center>


</BorderPane>
