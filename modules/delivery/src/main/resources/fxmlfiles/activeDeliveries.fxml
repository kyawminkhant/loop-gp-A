<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="LoopProject.loopproject.controllers.ActiveDeliveries"
            stylesheets="@../styles/activeDeliveries.css"
            styleClass="ActiveDeliveries">
    <center>
        <VBox alignment="TOP_CENTER" spacing="10">
            <ImageView fx:id="logo" fitWidth="150" preserveRatio="true">
                <image><Image url="@../images/logo.png"/></image>
            </ImageView>
            <VBox styleClass="main-container" alignment="TOP_CENTER" spacing="12">
                <Label text="Active Deliveries" styleClass="section-title"/>
                <ScrollPane fitToWidth="true" prefHeight="480">
                    <VBox fx:id="activeDeliveryList" spacing="12"/>
                </ScrollPane>
                <Label fx:id="statusLabel" text="Status updates are shared with Orders."
                       wrapText="true"/>
            </VBox>
            <Button text="← Back" onAction="#goBack" styleClass="back-button"/>
        </VBox>
    </center>
</BorderPane>
